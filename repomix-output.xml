      totalBalance: 12500000,
      monthly: MonthlyStats(income: 5000000, expense: 2000000),
      wallets: [
        Wallet(
          id: '1',
          name: 'MOCK Wallet',
          balance: 5000000,
          color: '#2563EB',
          icon: 'wallet',
        ),
        Wallet(
          id: '2',
          name: 'MOCK Wallet 2',
          balance: 7500000,
          color: '#10B981',
          icon: 'account_balance_wallet',
        ),
      ],
      last6Months: [
        MonthlyFlow(month: '1/2026', income: 5000000, expense: 2000000)
      ],
      topCategories: [
        TopCategory(
            name: 'MOCK',
            color: '#2563EB',
            icon: '📝',
            amount: 1000000,
            percentage: 50)
